config="${ZOXY_CONFIG:-/etc/zoxy/config.json}"
explicit_target=""

if [ "${1:-}" = "--target" ]; then
  if [ "$#" -lt 2 ]; then
    printf '%s\n' 'usage: zoxy [--target <id>] [/path/to/game.exe]' >&2
    exit 2
  fi
  explicit_target="$2"
  shift 2
fi

validate_path() {
  local path="$1"
  if [ ! -f "$path" ]; then
    printf 'zoxy: file does not exist: %s\n' "$path" >&2
    exit 1
  fi
  case "$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')" in
    *.exe) ;;
    *)
      printf 'zoxy: expected a Windows executable: %s\n' "$path" >&2
      exit 1
      ;;
  esac

  local allowed=0
  if [ -r "$config" ]; then
    while IFS= read -r root_dir; do
      [ -n "$root_dir" ] || continue
      local real_root
      real_root=$(realpath -e "$root_dir" 2>/dev/null || true)
      if [ -n "$real_root" ]; then
        case "$path" in "$real_root"/*) allowed=1; break ;; esac
      fi
    done < <(jq -r '.gameRoots[]? // empty' "$config")
  fi

  if [ "$allowed" -ne 1 ]; then
    printf 'zoxy: path is outside configured game roots: %s\n' "$path" >&2
    exit 1
  fi
  realpath -e "$path"
}

focus_game() {
  if [ -n "${NIRI_SOCKET:-}" ] && command -v niri >/dev/null 2>&1; then
    (
      for _ in $(seq 1 40); do
        sleep 1
        wid=$(niri msg -j windows 2>/dev/null | jq -r '.[] | select((.app_id // "") | test("^steam_app_")) | .id' | tail -n 1)
        if [ -n "$wid" ] && [ "$wid" != "null" ]; then
          niri msg action focus-window --id "$wid" 2>/dev/null || true
          break
        fi
      done
    ) &
  fi
}

game_path=""
if [ "$#" -ge 1 ]; then
  game_path=$(validate_path "$1")
  shift
fi

if [ -z "$game_path" ]; then
  if ! selected=$(zoxy-list-games | fzf \
    --delimiter=$'\t' \
    --with-nth=1,2,3,4 \
    --prompt='🎮 选择游戏 > ' \
    --header='[Enter] 选择游戏  |  [Esc] 退出' \
    --preview='printf "\033[1;36m🎮 游戏名称:\033[0m {2}\n\033[1;33m🏷️  运行类型:\033[0m {1}\n\033[1;32m💾 文件大小:\033[0m {4}\n\033[1;35m📂 目标程序:\033[0m {3}\n\n\033[1;30m📁 完整路径:\033[0m\n{5}"' \
    --preview-window='down:6:wrap:border-top' \
    --height='80%' \
    --layout='reverse' \
    --border='rounded' \
    --info='inline'); then
    rc=$?
    if [ "$rc" -eq 1 ] || [ "$rc" -eq 130 ]; then
      exit 0
    fi
    exit "$rc"
  fi

  [ -n "$selected" ] || exit 0
  raw_path="${selected##*$'\t'}"
  game_path=$(validate_path "$raw_path")
fi

target_id="$explicit_target"
if [ -z "$target_id" ]; then
  # Build target menu: local first, then remote targets
  menu_items=""
  if [ -r "$config" ]; then
    menu_items=$(jq -r '
      .targets | to_entries | sort_by(if .value.type == "local" then 0 else 1 end)[]
      | [ .key, (.value.label // .key), (if .value.type == "local" then "本机启动" else ("串流: " + (.value.clientHost // "")) end) ]
      | @tsv
    ' "$config")
  fi

  if [ -z "$menu_items" ]; then
    target_id="local"
  else
    count=$(printf '%s\n' "$menu_items" | grep -c .)
    if [ "$count" -le 1 ]; then
      target_id=$(printf '%s\n' "$menu_items" | cut -f 1)
    else
      if ! chosen=$(printf '%s\n' "$menu_items" | fzf \
        --delimiter=$'\t' \
        --with-nth=2,3 \
        --prompt='🎯 启动位置 > ' \
        --header='[Enter] 启动  |  [Esc] 退出' \
        --height='40%' \
        --layout='reverse' \
        --border='rounded' \
        --info='inline'); then
        rc=$?
        if [ "$rc" -eq 1 ] || [ "$rc" -eq 130 ]; then
          exit 0
        fi
        exit "$rc"
      fi
      [ -n "$chosen" ] || exit 0
      target_id=$(printf '%s\n' "$chosen" | cut -f 1)
    fi
  fi
fi

target_type=""
if [ -r "$config" ]; then
  target_type=$(jq -r --arg id "$target_id" '.targets[$id].type // empty' "$config")
fi

if [ -z "$target_type" ]; then
  printf 'zoxy: target not found in configuration: %s\n' "$target_id" >&2
  exit 1
fi

if [ "$target_type" = "local" ]; then
  printf '正在本机启动: %s\n' "$game_path"
  focus_game
  exec zoxy-run "$game_path" "$@"
elif [ "$target_type" = "moonlight-client" ]; then
  target_label=$(jq -r --arg id "$target_id" '.targets[$id].label // $id' "$config")
  printf '正在串流到 %s: %s\n' "$target_label" "$game_path"
  exec zoxy-stream-request "$target_id" "$game_path"
else
  printf 'zoxy: unknown target type: %s\n' "$target_type" >&2
  exit 1
fi
