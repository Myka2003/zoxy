cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zoxy/sources"
shopt -s nullglob
files=("$cache_dir"/*.json)
if [ "${#files[@]}" -eq 0 ]; then
  printf '%s\n' 'zoxy-search: no cache; run zoxy-source-sync first' >&2
  exit 1
fi

if selected=$(jq -r '
  .name as $index_source
  | .downloads[]?
  | select((.title | type) == "string")
  | . as $download
  | ($download.title | gsub("[\\t\\r\\n]"; " ")) as $title
  | ($title | ascii_downcase) as $title_lower
  | (if $title_lower | contains("[gog]") then "GOG"
     elif $title_lower | contains("[fitgirl") then "FitGirl"
     elif $title_lower | contains("[dodi") then "DODI"
     elif $title_lower | contains("[steamrip") then "SteamRIP"
     elif ($title_lower | contains("[p]") or contains("[portable]")) then "Portable"
     else ($index_source // "Unknown")
     end) as $source_label
  | (($download.uris // []) | map(select((type == "string") and startswith("magnet:"))) | first) as $uri
  | select($uri != null)
  | [
      ("[" + $source_label + "]"),
      $title,
      (($download.fileSize // "未知大小") | tostring),
      (($download.uploadDate // "-") | tostring | split("T")[0]),
      ($uri | gsub("&#0*38;|&amp;"; "&"))
    ]
  | @tsv
' "${files[@]}" | fzf \
  --delimiter=$'\t' \
  --with-nth=1,2,3 \
  --prompt='🎮 搜索游戏 > ' \
  --header='[Enter] 推送后台下载并打开仪表盘  |  [Esc] 退出' \
  --preview='printf "\033[1;36m🎮 游戏名称:\033[0m {2}\n\033[1;33m📦 发布来源:\033[0m {1}\n\033[1;32m💾 文件大小:\033[0m {3}\n\033[1;35m📅 更新日期:\033[0m {4}\n\n\033[1;30m🧲 磁力链接:\033[0m\n{5}"' \
  --preview-window='down:6:wrap:border-top' \
  --height='80%' \
  --layout='reverse' \
  --border='rounded' \
  --info='inline'); then
  :
else
  rc=$?
  if [ "$rc" -eq 1 ] || [ "$rc" -eq 130 ]; then
    exit 0
  fi
  exit "$rc"
fi

zoxy-download "${selected##*$'\t'}" >/dev/null
zoxy-tui
