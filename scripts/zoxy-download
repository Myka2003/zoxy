if [ "$#" -ne 1 ]; then
  printf '%s\n' 'usage: zoxy-download magnet:?xt=...'
  exit 2
fi

magnet=$1
case "$magnet" in
  magnet:*) ;;
  *)
    printf '%s\n' 'zoxy-download: expected a magnet URI' >&2
    exit 2
    ;;
esac

curl --fail --silent --show-error --request POST \
  "${ZOXY_DOWNLOADER_URL:-http://127.0.0.1:8080}/api/v2/torrents/add" \
  --data-urlencode "urls=$magnet"
printf '%s\n' 'zoxy-download: added'
